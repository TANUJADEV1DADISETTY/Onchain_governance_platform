FROM node:18-alpine

WORKDIR /app

COPY package.json ./

# Install dependencies (ignoring scripts to avoid husky or other hooks)
# Add python/make/g++ for native modules compilation if needed (often needed for hardhat/node-gyp)
RUN apk add --no-cache python3 make g++ && \
    npm install --ignore-scripts

COPY . .

EXPOSE 8545

CMD ["npx", "hardhat", "node"]
